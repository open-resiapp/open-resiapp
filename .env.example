APP_NAME="Bytové spoločenstvo Hlavná 12"
APP_URL=http://localhost:3000
APP_DOMAIN=localhost

# Database
DATABASE_URL=postgresql://postgres:zmenMaPlease123@localhost:5433/resiapp
POSTGRES_PASSWORD=zmenMaPlease123

# Auth
NEXTAUTH_SECRET=change-me-to-a-random-64-char-string-in-production-please-now
NEXTAUTH_URL=http://localhost:3000

# Email (optional — SMTP via Brevo or similar)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@mojabytovka.sk

# When true, vote fails if confirmation email fails to send
REQUIRE_VOTE_EMAIL=false

# Community cron — shared secret between app and cron sidecar.
# Also guards POST /api/cron/accounting-rates (central-bank rate sync).
# Generate with: openssl rand -base64 32
CRON_SECRET=change-me-to-a-random-secret

# Accounting rate sync (úroky z omeškania). ECB MRO rate uses a built-in
# ECB Data Portal CSV URL; set the ČNB two-week repo CSV export here (ARAD).
# Leave empty to sync only the SK/ECB series. VERIFY the series before use.
CNB_REPO_CSV_URL=

# Web Push (PWA notifications) — required for push to work on installed PWAs
# Generate a fresh keypair with: npx web-push generate-vapid-keys
# Public key is exposed to the browser (NEXT_PUBLIC_*); private stays server-side.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact URL or mailto for the push provider (Mozilla / Apple / Google).
VAPID_SUBJECT=mailto:admin@example.com

# Cloud-only flags (managed-hosting). Self-hosted users leave unset.
# CLOUD_SSO_SECRET — shared with cloud's SSO mint endpoint. NOT NEXTAUTH_SECRET.
# INSTANCE_ORG_ID — injected by cloud provisioner; SSO tokens whose org_id
#                   claim mismatches are rejected.
# PLATFORM_IMPORT_TOKEN — per-instance bearer secret for identity import +
#                   export endpoints. Unset on self-hosted → endpoints 503.
# IS_SANDBOX=true — paints the DEMO banner; cloud sets this on sandbox
#                   instances only.
# IS_READONLY=true — middleware blocks non-GET /api/** with HTTP 423; banner
#                   appears on every dashboard page. Cloud trips this on
#                   sandbox trial expiry during the 7-day grace period.
# CLOUD_PROMOTE_URL — when set alongside IS_READONLY, the readonly banner
#                   renders a "Promote to production" CTA pointing here.
CLOUD_SSO_SECRET=
INSTANCE_ORG_ID=
PLATFORM_IMPORT_TOKEN=
IS_SANDBOX=
IS_READONLY=
CLOUD_PROMOTE_URL=

# ---------------------------------------------------------------------------
# Object storage (uploads / documents)
# ---------------------------------------------------------------------------
# STORAGE_DRIVER selects the backend:
#   local (default) — files on disk, no extra config. Good for self-hosted.
#   s3              — any S3-compatible store (AWS S3 or Hetzner Object Storage).
STORAGE_DRIVER=local

# Local driver: where files live. Defaults to ./uploads relative to the app.
UPLOADS_PATH=

# --- S3 driver (shared) — only used when STORAGE_DRIVER=s3 ---
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Flip to true only if your provider/bucket requires path-style addressing.
S3_FORCE_PATH_STYLE=false

# --- Option A: AWS S3 ---
# Leave S3_ENDPOINT empty; the SDK derives it from the region.
# S3_REGION=eu-central-1
# S3_ENDPOINT=

# --- Option B: Hetzner Object Storage ---
# Region is the location code; endpoint is location.your-objectstorage.com.
# Locations: fsn1 (Falkenstein), nbg1 (Nuremberg), hel1 (Helsinki).
# S3_REGION=fsn1
# S3_ENDPOINT=https://fsn1.your-objectstorage.com
